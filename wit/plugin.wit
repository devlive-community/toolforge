// ToolForge 插件契约：在线安装的插件编译为 wasm32-wasip2 组件，按此世界导出与导入。
// 参数、结果与日志参数都以 JSON 字符串传递，与原生 ToolPlugin 的语义一一对应。
package toolforge:plugin@0.1.0;

interface host {
    enum log-level { debug, info, warn, error }

    /// 插件错误：错误码 + JSON 对象形式的参数，由前端翻译
    record failure {
        code: string,
        params: string,
    }

    /// 以下函数只在 run-task 期间有效；普通调用中调用会被忽略或返回失败
    log: func(level: log-level, code: string, params: string);
    progress: func(done: u64, total: u64);
    stage: func(code: string);
    is-cancelled: func() -> bool;

    /// 读取用户选择的文件（需要 fs:user-selected 权限）
    file-size: func(path: string) -> result<u64, failure>;
    read-file: func(path: string, offset: u64, length: u32) -> result<list<u8>, failure>;
    /// 写入用户选择的文件，覆盖原内容（需要 fs:user-selected 权限）
    write-file: func(path: string, data: list<u8>) -> result<_, failure>;

    /// 由宿主发送的 HTTP 请求（需要 network 权限）
    record http-request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        timeout-ms: u32,
        follow-redirects: bool,
        max-redirects: u32,
        use-proxy: bool,
        max-body: u64,
    }

    record http-response {
        status: u16,
        reason: string,
        version: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        redirects: list<string>,
        elapsed-ms: u64,
    }

    /// 发送请求并读取完整响应；在任务中可被取消，并报告读取进度
    http-send: func(request: http-request) -> result<http-response, failure>;

    /// 在 127.0.0.1 上监听一次性回调（需要 network 权限）；port 为 0 时由系统分配。
    /// 返回监听编号与实际端口；只接受第一个匹配路径的 GET 请求
    callback-listen: func(port: u16, path: string, timeout-ms: u32) -> result<tuple<u32, u16>, failure>;
    /// 收到回调时返回查询字符串，仍在等待时为 none
    callback-poll: func(id: u32) -> result<option<string>, failure>;
    /// 停止监听并释放端口
    callback-close: func(id: u32);

    /// 流式请求（需要 network 权限）：逐块读取响应体，结束时拿到 trailers；用于 gRPC、SSE
    record stream-request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        /// 整个流的截止时间
        timeout-ms: u32,
        /// http:// 地址直接使用 HTTP/2（h2c）；https 由 ALPN 协商
        http2-prior-knowledge: bool,
    }

    record stream-head {
        status: u16,
        reason: string,
        version: string,
        headers: list<tuple<string, string>>,
    }

    variant stream-event {
        /// 一块响应体
        data(list<u8>),
        /// 等待期间没有新数据
        pending,
        /// 响应结束，附带 trailers
        end(list<tuple<string, string>>),
    }

    /// 连接并发送请求，返回流编号与响应头
    http-stream-open: func(request: stream-request) -> result<tuple<u32, stream-head>, failure>;
    /// 最多等待 wait-ms 毫秒读取下一块
    http-stream-read: func(id: u32, wait-ms: u32) -> result<stream-event, failure>;
    /// 中止并释放流
    http-stream-close: func(id: u32);
}

world plugin {
    use host.{failure};
    import host;

    export call: func(function: string, args: string) -> result<string, failure>;
    export run-task: func(function: string, args: string) -> result<string, failure>;
    /// 识别剪贴板文本，返回 Detection 的 JSON；不识别时为 none
    export detect: func(text: string) -> option<string>;
}
