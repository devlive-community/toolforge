{
  "id": "org.devlive.toolforge.markdown-editor",
  "version": "0.2.1",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "text",
  "keywords": ["markdown", "md", "editor", "preview", "gfm", "readme", "html", "export", "outline", "Markdown 编辑器", "预览", "文档", "导出"],
  "accent": "blue",
  "locales": ["zh-CN", "en-US"],
  "minAppVersion": "0.2.0",
  "permissions": ["fs:user-selected", "clipboard:write"],
  "functions": {
    "render": {
      "history": true,
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.render.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "description": "i18n:api.render.source", "x-positional": 0, "x-stdin": true }
          }
        },
        "examples": ["cat README.md | tfp-markdown-editor render --json"]
      }
    },
    "export_html": {
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.export_html.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "description": "i18n:api.export_html.source", "x-positional": 0, "x-stdin": true },
            "title": { "type": "string", "description": "i18n:api.export_html.title" }
          }
        },
        "output": { "text": "/html" },
        "examples": ["cat README.md | tfp-markdown-editor export_html --title Readme"]
      }
    }
  },
  "sensitive": false
}
