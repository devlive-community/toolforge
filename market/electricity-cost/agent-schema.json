{
  "pluginId": "org.devlive.toolforge.electricity-cost",
  "schemaVersion": 1,
  "externalTransport": null,
  "functions": {
    "calculate": {
      "task": true,
      "readOnly": true,
      "permissions": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "appliances": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/appliance"
            }
          },
          "tariffs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/tariff"
            }
          }
        },
        "required": [
          "days",
          "currency",
          "appliances",
          "tariffs"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "power": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$",
                "description": "Nonnegative decimal string, up to 3 decimal places. No exponent."
              },
              "unit": {
                "enum": [
                  "w",
                  "kw"
                ]
              },
              "peak": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$",
                "description": "Nonnegative decimal string, up to 3 decimal places. No exponent."
              },
              "shoulder": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$",
                "description": "Nonnegative decimal string, up to 3 decimal places. No exponent."
              },
              "valley": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$",
                "description": "Nonnegative decimal string, up to 3 decimal places. No exponent."
              }
            },
            "required": [
              "power",
              "unit",
              "peak",
              "shoulder",
              "valley"
            ],
            "description": "Daily equivalent runtime per tariff period; combined runtime cannot exceed 24 hours. Power max 1000000 W or 1000 kW."
          },
          "tier": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "upTo": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$",
                    "description": "Nonnegative decimal string, up to 3 decimal places. No exponent."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rate": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$",
                "description": "Currency per kWh, 0 through 1000."
              }
            },
            "required": [
              "upTo",
              "rate"
            ]
          },
          "pricing": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "flat"
                  },
                  "rate": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$",
                    "description": "Currency per kWh, 0 through 1000."
                  }
                },
                "required": [
                  "kind",
                  "rate"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "tiered"
                  },
                  "tiers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "$ref": "#/$defs/tier"
                    }
                  }
                },
                "required": [
                  "kind",
                  "tiers"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "tou"
                  },
                  "peak": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$",
                    "description": "Currency per kWh, 0 through 1000."
                  },
                  "shoulder": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$",
                    "description": "Currency per kWh, 0 through 1000."
                  },
                  "valley": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$",
                    "description": "Currency per kWh, 0 through 1000."
                  }
                },
                "required": [
                  "kind",
                  "peak",
                  "shoulder",
                  "valley"
                ]
              }
            ]
          },
          "tariff": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "pricing": {
                "$ref": "#/$defs/pricing"
              }
            },
            "required": [
              "id",
              "name",
              "pricing"
            ]
          },
          "appliance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "usage": {
                "$ref": "#/$defs/usage"
              },
              "alternative": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/usage"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "quantity",
              "usage"
            ]
          }
        }
      },
      "output": "Session handle and summaries; all quantities and money are decimal strings. query pages appliance rows."
    },
    "query": {
      "task": true,
      "readOnly": true,
      "permissions": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "tariff": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "handle",
          "tariff"
        ]
      }
    },
    "export": {
      "task": true,
      "readOnly": false,
      "permissions": [
        "fs:user-selected (only when path is supplied)"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ]
          },
          "language": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "handle",
          "format",
          "language"
        ]
      },
      "confirmation": "File paths must be explicitly authorized by the caller host; a path supplied by an agent does not itself grant file access. No path returns bounded content without writing."
    }
  },
  "boundaries": [
    "No external MCP/CLI/API listener is provided by this plugin.",
    "Session handles expire after the next successful calculation. Failed or cancelled calculations retain the previous handle.",
    "Tier thresholds are monthly household kWh, not per-appliance allowances.",
    "Annualized costs assume 12 identical billing months. No automatic energy-efficiency or temperature savings factors.",
    "book constructs a validated candidate only. Existing ToolForge SQLite persistence requires a separate acknowledged host write."
  ]
}
