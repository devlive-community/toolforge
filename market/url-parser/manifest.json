{
  "id": "org.devlive.toolforge.url-parser",
  "version": "0.1.2",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "network",
  "keywords": ["url", "uri", "link", "query string", "query parameters", "parse url", "utm", "tracking", "punycode", "idn", "链接", "网址", "参数", "解析", "跟踪参数"],
  "accent": "blue",
  "locales": ["zh-CN", "en-US"],
  "minAppVersion": "0.2.0",
  "permissions": ["clipboard:read", "clipboard:write"],
  "functions": {
    "parse": {
      "history": true,
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.parse.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["input"],
          "properties": {
            "input": { "type": "string", "description": "i18n:api.parse.input", "x-positional": 0, "x-stdin": true }
          }
        },
        "examples": ["tfp-url-parser parse 'https://example.com:8080/a?b=1#c'"]
      }
    },
    "build": { "interface": false },
    "strip_tracking": {
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.strip_tracking.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["input"],
          "properties": {
            "input": { "type": "string", "description": "i18n:api.strip_tracking.input", "x-positional": 0, "x-stdin": true }
          }
        },
        "examples": ["tfp-url-parser strip_tracking 'https://example.com/?utm_source=x&id=1'"]
      }
    }
  },
  "sensitive": false
}
