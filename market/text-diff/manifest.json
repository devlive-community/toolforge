{
  "id": "org.devlive.toolforge.text-diff",
  "version": "0.1.2",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "text",
  "keywords": ["diff", "compare", "difference", "patch", "unified", "ignore", "regex", "文本对比", "差异", "比较", "对比"],
  "accent": "orange",
  "locales": ["zh-CN", "en-US"],
  "minAppVersion": "0.2.0",
  "permissions": ["clipboard:read", "clipboard:write", "fs:user-selected"],
  "functions": {
    "diff": {
      "history": true,
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.diff.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["left", "right"],
          "properties": {
            "left": { "type": "string", "description": "i18n:api.diff.left", "x-positional": 0 },
            "right": { "type": "string", "description": "i18n:api.diff.right", "x-positional": 1 },
            "mode": { "type": "string", "description": "i18n:api.diff.mode", "enum": ["lines", "words", "chars"], "default": "lines" },
            "algorithm": { "type": "string", "description": "i18n:api.diff.algorithm", "enum": ["myers", "patience"], "default": "myers" },
            "ignoreCase": { "type": "boolean", "description": "i18n:api.diff.ignoreCase", "default": false },
            "ignoreWhitespace": { "type": "boolean", "description": "i18n:api.diff.ignoreWhitespace", "default": false },
            "ignorePatterns": { "type": "array", "description": "i18n:api.diff.ignorePatterns", "items": { "type": "string" } }
          }
        },
        "output": { "text": "/unified" },
        "examples": ["tfp-text-diff diff \"$(cat a.txt)\" \"$(cat b.txt)\""]
      }
    }
  },
  "sensitive": false
}
