{
  "id": "org.devlive.toolforge.sarif-viewer",
  "version": "0.1.1",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "dev",
  "keywords": [
    "sarif",
    "static analysis",
    "code scanning",
    "linter",
    "security",
    "静态分析",
    "扫描报告",
    "代码检查"
  ],
  "accent": "violet",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [
    "fs:user-selected"
  ],
  "functions": {
    "parse": {
      "task": true,
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.parse.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["paths"],
          "properties": {
            "paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "i18n:api.parse.paths",
              "x-positional": 0
            }
          }
        },
        "examples": [
          "tfp-sarif-viewer parse report.sarif",
          "tfp-sarif-viewer parse eslint.sarif clippy.sarif"
        ]
      }
    },
    "browse": {
      "task": true,
      "interface": false
    },
    "detail": {
      "task": true,
      "interface": false
    },
    "readSource": {
      "task": true,
      "interface": false
    },
    "export": {
      "task": true,
      "interface": false
    }
  },
  "sensitive": true
}
