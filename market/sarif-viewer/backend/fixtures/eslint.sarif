{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "eslint",
          "version": "8.57.0",
          "informationUri": "https://eslint.org",
          "rules": [
            {
              "id": "no-unused-vars",
              "name": "NoUnusedVariables",
              "shortDescription": { "text": "disallow unused variables" },
              "defaultConfiguration": { "level": "warning" },
              "helpUri": "https://eslint.org/rules/no-unused-vars",
              "messageStrings": { "default": { "text": "'{0}' is defined but never used." } }
            },
            {
              "id": "no-flow",
              "shortDescription": { "text": "report control flow" }
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "artifacts": [
        { "location": { "uri": "src/app.ts", "uriBaseId": "SRCROOT" }, "sourceLanguage": "ts" },
        { "location": { "uri": "src/lib/util.ts", "uriBaseId": "SRCROOT" }, "roles": ["analysisTarget"] }
      ],
      "originalUriBaseIds": {
        "SRCROOT": { "uri": "file:///home/dev/project/" }
      },
