{
  "id": "org.devlive.toolforge.physics-calculator",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "calc",
  "keywords": [
    "physics",
    "kinematics",
    "ohm",
    "force",
    "物理",
    "公式",
    "运动学",
    "欧姆定律"
  ],
  "accent": "blue",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "solve": {
      "history": true,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.solve.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": [
            "card",
            "target",
            "given"
          ],
          "properties": {
            "card": {
              "type": "string",
              "description": "i18n:api.solve.card",
              "x-positional": 0
            },
            "target": {
              "type": "string",
              "description": "i18n:api.solve.target",
              "x-positional": 1
            },
            "given": {
              "type": "object",
              "description": "i18n:api.solve.given",
              "default": {
                "m": 2,
                "a": 3
              }
            }
          }
        },
        "examples": [
          "tfp-physics-calculator solve newton a --given '{\"f\":10,\"m\":2}'",
          "tfp-physics-calculator solve kinematics_v v --given '{\"v0\":2,\"a\":3,\"t\":4}'"
        ]
      }
    },
    "constants": {
      "history": false,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.constants.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "properties": {}
        },
        "examples": [
          "tfp-physics-calculator constants"
        ]
      }
    }
  },
  "sensitive": false
}
