{
  "id": "org.devlive.toolforge.shortcut-cheatsheet",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "dev",
  "keywords": [
    "shortcut",
    "keyboard",
    "hotkey",
    "cheatsheet",
    "快捷键",
    "键位",
    "手册"
  ],
  "accent": "gray",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "list": {
      "history": false,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.list.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "description": "i18n:api.list.app"
            },
            "query": {
              "type": "string",
              "description": "i18n:api.list.query",
              "x-positional": 0
            }
          }
        },
        "examples": [
          "tfp-shortcut-cheatsheet list --app vscode",
          "tfp-shortcut-cheatsheet list split"
        ]
      }
    }
  },
  "sensitive": false
}
