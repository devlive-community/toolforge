{
  "id": "org.devlive.toolforge.plant-care",
  "version": "0.1.1",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "life",
  "keywords": [
    "plant",
    "care",
    "watering",
    "journal",
    "growth",
    "植物",
    "浇水",
    "养护",
    "成长"
  ],
  "accent": "green",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [
    "fs:user-selected",
    "clipboard:write"
  ],
  "functions": {
    "bootstrap": { "interface": false },
    "today": { "interface": false },
    "inspect": { "task": true, "interface": false },
    "apply": { "task": true, "interface": false },
    "preview": { "task": true, "interface": false },
    "photos": { "task": true, "interface": false },
    "export": { "task": true, "interface": false },
    "restore": { "task": true, "interface": false },
    "due": {
      "interface": {
        "expose": ["cli", "agent"],
        "summary": "i18n:api.due.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": { "type": "array", "items": { "type": "string" }, "description": "i18n:api.due.items", "x-positional": 0 },
            "today": { "type": "string", "description": "i18n:api.due.today" }
          }
        },
        "output": { "table": "", "columns": [{ "key": "name", "label": "i18n:api.columns.name" }, { "key": "last", "label": "i18n:api.columns.last" }, { "key": "next", "label": "i18n:api.columns.next" }, { "key": "days", "label": "i18n:api.columns.days" }, { "key": "state", "label": "i18n:api.columns.state" }] },
        "examples": ["tfp-plant-care due Fern:7:2026-10-25,Cactus:30:2026-09-01"]
      }
    }
  },
  "sensitive": true
}
