{
  "id": "org.devlive.toolforge.stargazing-guide",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "life",
  "keywords": [
    "stars",
    "sky",
    "constellation",
    "星空",
    "星座",
    "观星"
  ],
  "accent": "indigo",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "sky": {
      "history": false,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.sky.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": [
            "latitude",
            "longitude",
            "timestampMs"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "description": "i18n:api.sky.latitude"
            },
            "longitude": {
              "type": "number",
              "description": "i18n:api.sky.longitude"
            },
            "timestampMs": {
              "type": "integer",
              "description": "i18n:api.sky.timestampMs"
            },
            "minAltitude": {
              "type": "number",
              "description": "i18n:api.sky.minAltitude"
            }
          }
        },
        "examples": [
          "tfp-stargazing-guide sky 40 116.4 --timestampMs 1760000000000"
        ]
      }
    }
  },
  "sensitive": false
}
