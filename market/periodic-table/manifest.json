{
  "id": "org.devlive.toolforge.periodic-table",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "dev",
  "keywords": [
    "element",
    "chemistry",
    "periodic",
    "元素",
    "周期表",
    "化学",
    "摩尔质量"
  ],
  "accent": "blue",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "list": {
      "history": false,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.list.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "i18n:api.list.query"
            },
            "category": {
              "type": "string",
              "description": "i18n:api.list.category"
            }
          }
        },
        "examples": [
          "tfp-periodic-table list 铁",
          "tfp-periodic-table list --category noble"
        ]
      }
    },
    "molar_mass": {
      "history": true,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.molar_mass.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": [
            "formula"
          ],
          "properties": {
            "formula": {
              "type": "string",
              "description": "i18n:api.molar_mass.formula",
              "x-positional": 0
            }
          }
        },
        "examples": [
          "tfp-periodic-table molar-mass H2O",
          "tfp-periodic-table molar-mass CuSO4"
        ]
      }
    }
  },
  "sensitive": false
}
