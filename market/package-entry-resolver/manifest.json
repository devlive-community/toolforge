{
  "id": "org.devlive.toolforge.package-entry-resolver",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "dev",
  "keywords": [
    "npm",
    "package",
    "exports",
    "node",
    "入口",
    "模块",
    "条件导出"
  ],
  "accent": "yellow",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "resolve": {
      "history": true,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.resolve.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": [
            "packageJson",
            "subpath"
          ],
          "properties": {
            "packageJson": {
              "type": "string",
              "description": "i18n:api.resolve.packageJson",
              "x-positional": 0,
              "x-stdin": true
            },
            "subpath": {
              "type": "string",
              "description": "i18n:api.resolve.subpath",
              "x-positional": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "i18n:api.resolve.conditions"
            },
            "listing": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "i18n:api.resolve.listing"
            }
          }
        },
        "examples": [
          "cat package.json | tfp-package-entry-resolver resolve . --conditions import,node"
        ]
      }
    }
  },
  "sensitive": false
}
