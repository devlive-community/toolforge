{
  "id": "org.devlive.toolforge.paper-size",
  "version": "0.1.0",
  "name": "i18n:name",
  "description": "i18n:description",
  "category": "other",
  "keywords": [
    "paper",
    "a4",
    "iso 216",
    "dpi",
    "envelope",
    "纸张",
    "尺寸",
    "像素",
    "打印"
  ],
  "accent": "orange",
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "minAppVersion": "0.2.0",
  "permissions": [],
  "functions": {
    "list": {
      "history": false,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.list.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "i18n:api.list.query",
              "x-positional": 0
            }
          }
        },
        "examples": [
          "tfp-paper-size list",
          "tfp-paper-size list a4",
          "tfp-paper-size list photo"
        ]
      }
    },
    "convert": {
      "history": true,
      "interface": {
        "expose": [
          "cli",
          "agent"
        ],
        "summary": "i18n:api.convert.summary",
        "effect": "read",
        "params": {
          "type": "object",
          "required": [
            "mm"
          ],
          "properties": {
            "mm": {
              "type": "number",
              "description": "i18n:api.convert.mm",
              "x-positional": 0
            },
            "dpi": {
              "type": "number",
              "description": "i18n:api.convert.dpi"
            }
          }
        },
        "examples": [
          "tfp-paper-size convert 210",
          "tfp-paper-size convert 210 --dpi 600"
        ]
      }
    }
  },
  "sensitive": false
}
