# Documentation only. Copy separately into restricted runtime.env, migrate.env,
# and catalog.env; never commit real credentials. EnvironmentFile format is not
# a shell script: do not add export, shell substitutions, or commands.
MYSQL_USER=toolforge_stats_runtime
MYSQL_PASSWORD=REPLACE_WITH_SEPARATELY_PROVISIONED_PASSWORD
MYSQL_DATABASE=toolforge_stats
MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
# Optional local DSN alternative. MYSQL_DSN overrides the MYSQL_* components.
# MYSQL_DSN=toolforge_stats_runtime:REPLACE@unix(/var/run/mysqld/mysqld.sock)/toolforge_stats
STATS_LISTEN_ADDR=127.0.0.1:8088
PLUGIN_ASSET_BASE_URL=https://plugins.toolforge.devlive.org
RECEIPT_ACTIVE_KID=first-production-key
# Replace the placeholder with standard base64 of >=32 cryptographically random
# bytes. The example is deliberately not a valid production keyring.
RECEIPT_KEYS_JSON='{"first-production-key":"REPLACE_WITH_BASE64_KEY"}'
# migrate.env/catalog.env need only the database settings, using distinct users.
# Test only: explicitly opt in to destructive tests in a dedicated *_test DB.
# TEST_MYSQL_DSN=toolforge_test:REPLACE@tcp(127.0.0.1:3306)/toolforge_stats_test?parseTime=true
