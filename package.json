{
  "name": "toolforge",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @toolforge/desktop tauri dev",
    "build": "cargo xtask cli-sidecar && pnpm --filter @toolforge/desktop tauri build --config src-tauri/tauri.release.conf.json",
    "web:dev": "pnpm --filter @toolforge/desktop dev",
    "web:build": "pnpm --filter @toolforge/desktop build",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check": "cargo xtask check",
    "release": "scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
